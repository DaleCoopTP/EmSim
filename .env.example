# Copy to .env before "docker compose up --build" (compose.yaml reads
# these; docker compose loads .env from the project directory automatically).

# PostgreSQL password shared by the postgres, migrate, bootstrap, api and
# worker services (compose.yaml's &database-url anchor).
POSTGRES_PASSWORD=local-only-postgres-password

# Initial admin account, created once by the one-shot "bootstrap" service
# (slice-planning.md §2). Login must match ^[a-z0-9._-]{3,64}$; password
# must be 8-256 bytes. The compose defaults below are for local demo use
# only — set a real BOOTSTRAP_ADMIN_PASSWORD for anything beyond that.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=local-only-admin-password

# Host-side port bindings; change if these are already taken.
API_PORT=8080
API_ADMIN_PORT=8081
WORKER_ADMIN_PORT=8082
