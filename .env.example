# Copy to .env before "docker compose up --build" (compose.yaml reads
# these; docker compose loads .env from the project directory automatically).

# PostgreSQL password shared by the postgres, migrate, bootstrap, api and
# worker services (compose.yaml's &database-url anchor).
POSTGRES_PASSWORD=local-only-postgres-password

# Initial admin account, created once by the one-shot "bootstrap" service
# (slice-planning.md §2). Login must match ^[a-z0-9._-]{3,64}$; password
# must be 8-256 bytes. The compose defaults below are for local demo use
# only — set a real BOOTSTRAP_ADMIN_PASSWORD for anything beyond that.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=local-only-admin-password

# Host-side port bindings; change if these are already taken.
API_PORT=8080
API_ADMIN_PORT=8081
WORKER_ADMIN_PORT=8082

# Shared content-addressed media root. Compose mounts this as /app/blobs.
BLOB_ROOT=./data/blobs

# Local model (ADR-029): compose.yaml's llm service (llama-server) serves
# both the AI caller and the description judge. Weights go to ./models via
# `make model`. The values below are the compose defaults, set before the
# W0 measurement on the target server (`emsim bench-llm`,
# slice-112-5b-plan.md) — tune them from its report.
# LLM_PARALLEL=4
# LLM_CTX_SIZE=16384
# LLM_THREADS=6
# Weight repacking: a faster CPU layout, but a ~4.7 GB copy of the weights
# in anonymous memory. On a machine with ~8 GB for Docker (e.g. Docker
# Desktop on a MacBook Air) llm is OOM-killed while loading with the
# defaults; use LLM_REPACK=false LLM_PARALLEL=1 LLM_CTX_SIZE=4096
# CALLER_CONCURRENCY=1 there (README, "Память").
# LLM_REPACK=true
# CALLER_CONCURRENCY=3
# LLM_CONCURRENCY=1
# CALLER_REPLY_TIMEOUT=30s
# CALLER_WARMUP=true
# Hold the caller's opening (a fixed, no-model line) back after the
# operator's first message, giving the prompt-cache warm-up a head start
# before the first model-answered question; 0s–10s, pick it from
# bench-llm's "warm ready" column.
# CALLER_OPENING_DELAY=0s
# Run without the model: CALLER_REPLIER=stub and ASSESSMENT_JUDGE=off with
# `docker compose -f compose.yaml -f compose.no-llm.yaml up`, which already
# defaults to both.

# Classroom profile (ADR-033, compose.class.yaml): the server name and/or
# IP the workstations open, e.g. "emsim.local" or "emsim.local, 192.168.10.5".
# Caddy issues its certificate for exactly these; `make class-ca` exports
# the root certificate to install on the classroom PCs.
# EMSIM_HOST=emsim.local
# HTTPS_PORT=443
# HTTP_PORT=80

# Remote OpenAI-compatible model instead of the bundled llm service
# (ADR-033, compose.remote-llm.yaml). Dialogue lines and caller
# descriptions then leave the premises — enable only where agreed.
# REMOTE_LLM_URL=https://llm.example/v1
# REMOTE_LLM_MODEL=
# LLM_API_KEY=
# LLM_DIALECT=openai
