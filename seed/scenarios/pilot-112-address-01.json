          {"id": "ask_address", "text": "Где вы находитесь?", "topic_id": "address", "answer": {"id": "address_partial", "text": "В Москве, на улице Мира, но номер дома сейчас не вижу.", "reveals": ["city", "street"]}},
          {"id": "clarify_house", "text": "Уточните дом и ориентир.", "topic_id": "address", "available_after": ["ask_address"], "answer": {"id": "house_reply", "text": "Дом 10, корпус 1, у остановки рядом с парком.", "reveals": ["house", "building", "landmark"]}},
          {"id": "ask_age", "text": "Сколько вам лет?", "topic_id": "applicant", "answer": {"id": "age_reply", "text": "Мне 34 года.", "reveals": ["age"]}},
          {"id": "ask_victims", "text": "Сколько человек нуждается в помощи?", "topic_id": "victims", "answer": {"id": "victims_reply", "text": "Один, это я.", "reveals": ["victims_count"]}},
          {"id": "ask_flat", "text": "Какой номер квартиры?", "topic_id": "address", "available_after": ["clarify_house"], "answer": {"id": "flat_reply", "text": "Номер квартиры мне неизвестен; сейчас я на улице.", "reveals": ["flat"]}}
