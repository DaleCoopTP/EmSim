{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emsim.local/schemas/scenario/v1",
  "title": "ScenarioBody v1",
  "description": "Тело версии сценария (scenario_versions.body). Неизменяемо после утверждения. Генерируется LLM по этой же схеме и валидируется до записи.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "difficulty", "exercise_type"],
  "allOf": [
    {
      "if": {"properties": {"exercise_type": {"const": "dds_processing"}}},
      "then": {
        "required": ["target_service", "card", "contacts", "events", "reference"],
        "not": {"required": ["intake112"]}
      }
    },
    {
      "if": {"properties": {"exercise_type": {"const": "operator112_intake"}}},
      "then": {
        "required": ["intake112"],
        "not": {"anyOf": [
          {"required": ["target_service"]}, {"required": ["card"]},
          {"required": ["contacts"]}, {"required": ["events"]},
          {"required": ["reference"]}
        ]}
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "emsim/scenario/v1"
    },
    "intake112": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "oneOf": [
        {"required": ["call", "recipient_services"], "properties": {"mode": {"enum": ["incoming_call"]}, "caller_mode": false, "call": {"required": ["script"]}, "dialogue": false, "reference": {"required": ["expected_card", "recipient_service"]}}},
        {"required": ["call", "recipient_services", "dialogue"], "properties": {"mode": {"enum": ["incoming_call"]}, "caller_mode": false, "call": {"not": {"required": ["script"]}}, "dialogue": {"required": ["initial", "questions"]}, "reference": {"required": ["expected_card", "recipient_service"]}}},
        {"required": ["mode"], "properties": {"mode": {"const": "card_only"}, "caller_mode": false, "reference": {"required": ["expected_types", "case_description"], "not": {"required": ["recipient_service"]}}}, "not": {"anyOf": [{"required": ["call"]}, {"required": ["dialogue"]}, {"required": ["recipient_services"]}]}},
        {"required": ["mode", "call", "dialogue"], "properties": {"mode": {"const": "full_case"}, "caller_mode": {"not": {"const": "free_text"}}, "call": {"not": {"required": ["script"]}}, "dialogue": {"required": ["initial", "questions"]}, "reference": {"required": ["expected_types", "case_description", "expected_services"], "not": {"required": ["recipient_service"]}}}, "not": {"required": ["recipient_services"]}},
        {"required": ["mode", "caller_mode", "call", "dialogue"], "properties": {"mode": {"const": "full_case"}, "caller_mode": {"const": "free_text"}, "call": {"not": {"required": ["script"]}}, "dialogue": {"not": {"anyOf": [{"required": ["initial"]}, {"required": ["questions"]}]}}, "reference": {"required": ["expected_types", "case_description", "expected_services"], "not": {"required": ["recipient_service"]}}}, "not": {"required": ["recipient_services"]}}
      ],
      "properties": {
        "mode": {"enum": ["incoming_call", "card_only", "full_case"]},
        "caller_mode": {"enum": ["prepared", "free_text"]},
        "call": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aon", "local_time", "time_zone"],
          "properties": {
            "aon": {"type": "string", "pattern": "^\\+7[0-9]{10}$"},
            "local_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
            "time_zone": {"const": "Europe/Moscow"},
            "script": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "dialogue": {
          "type": "object", "additionalProperties": false,
          "required": ["facts"],
          "properties": {
            "facts": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "label", "knowledge"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
                "label": {"type": "string", "minLength": 1},
                "card_path": {"type": "string", "pattern": "^/[a-z_]+(/[a-z_]+)?$", "description": "Обязателен у prepared-диалогов; необязателен у free_text (112-5b) — нарративный факт без своего поля карточки. internal/content.Validate проверяет required по caller_mode структурно эта схема этого не различает."},
                "knowledge": {"enum": ["initial", "on_question", "unknown"]},
                "value": {"type": "string", "minLength": 1},
                "statement": {"type": "string", "minLength": 1, "description": "112-5b: как заявитель сказал бы этот факт своими словами; обязателен у initial/on_question фактов при заданном dialogue.caller (internal/content.Validate)."},
                "ask_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "112-5b: RE2-регэкспы (компилируются с неявным \"(?i)\"); \\b запрещён."},
                "ask_exclude_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "disclosure_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "answer_variants": {"type": "array", "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["text"],
                  "properties": {
                    "when": {"type": "string", "minLength": 1, "description": "RE2-регэксп по реплике оператора; пусто — вариант без условия."},
                    "text": {"type": "string", "minLength": 1}
                  }
                }}
              },
              "allOf": [
                {"if": {"properties": {"knowledge": {"const": "unknown"}}}, "then": {"not": {"required": ["value"]}}},
                {"if": {"properties": {"knowledge": {"enum": ["initial", "on_question"]}}}, "then": {"required": ["value"]}}
              ]
            }},
            "caller": {
              "type": "object", "additionalProperties": false,
              "required": ["persona", "opening"],
              "description": "112-5b: включает ИИ-адаптер для free_text-диалога; отсутствие — заглушка, как в 112-5a (internal/content.Validate).",
              "properties": {
                "persona": {"type": "string", "minLength": 1},
                "opening": {"$ref": "#/$defs/intake112Utterance"}
              }
            },
            "initial": {"$ref": "#/$defs/intake112Utterance"},
            "questions": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "text", "topic_id", "answer"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
                "text": {"type": "string", "minLength": 1},
                "topic_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
                "available_after": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "answer": {"$ref": "#/$defs/intake112Utterance"}
              }
            }}
          }
        },
        "recipient_services": {
          "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reference": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "expected_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["gas_explosion", "road_traffic_fire", "gas_explosion_road_traffic_fire"]}},
            "case_description": {"type": "string", "minLength": 1},
            "expected_services": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Закрытый эталон списка служб (ADR-023 — ручной разбор; 112-6/ADR-026 — также P_SERVICES). Допустим для card_only и full_case."},
            "expected_card": {
              "type": "object", "additionalProperties": false,
              "description": "112-6/ADR-026: допустим в любом режиме, не только incoming_call. Каждое поле необязательно — отсутствующее не участвует в оценке (\"эталон отсутствует\" внутри блока, ADR-026), а не считается неверным.",
              "properties": {
                "applicant_status": {"type": "string", "minLength": 1},
                "applicant_name": {"type": "string", "minLength": 1, "description": "112-6: эталонное ФИО заявителя — сравнивается, только если факт был раскрыт в разговоре (P_APPLICANT_NAME)."},
                "age": {"type": "integer", "minimum": 0, "maximum": 120},
                "address": {
                  "type": "object", "additionalProperties": false,
                  "properties": {
                    "country": {"type": "string"}, "region": {"type": "string"},
                    "okrug": {"type": "string"}, "district": {"type": "string"},
                    "city": {"type": "string"}, "street": {"type": "string"},
                    "house": {"type": "string"}, "building": {"type": "string"},
                    "structure": {"type": "string"}, "flat": {"type": "string"},
                    "entrance": {"type": "string"}, "floor": {"type": "string"},
                    "landmark": {"type": "string"}
                  }
                },
                "incident_type": {"type": "string", "minLength": 1},
                "complaint": {"type": "string", "minLength": 1},
                "victims_count": {"type": "integer", "minimum": 1}
              }
            },
            "recipient_service": {"type": "string", "minLength": 1},
            "alternatives": {
              "type": "object",
              "description": "112-6/ADR-026: путь эталонного поля (то же обозначение, что expected_card.address.* или applicant_name/complaint) → дополнительные значения, тоже засчитываемые как верные после нормализации.",
              "additionalProperties": {
                "type": "array", "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "expected_profiles": {
              "type": "object",
              "description": "112-6/ADR-026: id профильной карты (intake_state.catalog profile id, например \"104\") → id поля этой карты → ожидаемое значение (строка для single/text) или массив значений (multiple).",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {"type": "string", "minLength": 1},
                    {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
                  ]
                }
              }
            },
            "scoring": {"$ref": "#/$defs/scoring"},
            "description_questions": {
              "type": "array", "maxItems": 20,
              "description": "ADR-028 (operator112/rubric-v3): контрольные вопросы к complaint («Описание со слов заявителя») для LLM-судьи DESCRIPTION_CONTENT. Формулируются положительно, например «Указано ли …?». Отсутствует/пусто — блок оценивается в 0 без вызова модели (ADR-026 «эталон отсутствует»). Уникальность id проверяется вне схемы (internal/content/validate.go).",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "question"],
                "properties": {
                  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
                  "question": {"type": "string", "minLength": 1, "maxLength": 300}
                }
              }
            }
          }
        }
      }
    },
    "target_service": {
      "type": "string",
      "description": "Код службы обучаемого (services.code)"
    },
    "card": {
      "$ref": "#/$defs/card"
    },
    "contacts": {
      "type": "array",
      "minItems": 0,
      "description": "Пусто, если ни один звонок сценарием не требуется (ни reference.call.required, ни события phone_incoming/notice не ссылаются на contact.key); тогда пустой список не удовлетворяет требованию звонка — семантическая проверка импортёра это гарантирует.",
      "items": {
        "$ref": "#/$defs/contact"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "reference": {
      "$ref": "#/$defs/reference"
    },
    "hints": {
      "type": "array",
      "description": "Подсказки для ознакомительного режима",
      "items": {
        "type": "object",
        "required": [
          "step",
          "text"
        ],
        "properties": {
          "step": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "guide_ref": {
            "type": "string"
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "description": "Происхождение, если сгенерировано",
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "ticket_id": {
          "type": "string",
          "format": "uuid"
        },
        "classifier_code": {
          "type": "string"
        }
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Сложность именно этой неизменяемой версии"
    },
    "exercise_type": {
      "type": "string",
      "enum": ["dds_processing", "operator112_intake"],
      "description": "Тип упражнения выбирает отдельный вариант сценария."
    }
  },
  "$defs": {
    "intake112Utterance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "reveals"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "text": {"type": "string", "minLength": 1},
        "reveals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "scoring": {
      "type": "object",
      "description": "Поправки к рубрике по умолчанию (ADR-013). Только отличия; отсутствие блока = дефолт. Общий для reference ДДС и intake112.reference (ADR-026).",
      "additionalProperties": false,
      "properties": {
        "weights": {
          "type": "object",
          "description": "criterion id → вес (переопределяет дефолт; нормируется к 100 среди включённых)",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "critical": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Критерии, невыполнение которых в этом кейсе критично"
        },
        "disabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Критерии, не применимые к кейсу"
        },
        "note": {
          "type": "string",
          "description": "Почему поправки такие — для преподавателя"
        }
      }
    },
    "reaction": {
      "type": "string",
      "enum": [
        "added",
        "received",
        "accepted",
        "not_accepted",
        "responding",
        "arrived",
        "working",
        "completed",
        "refused",
        "completed_without_team"
      ]
    },
    "card": {
      "type": "object",
      "description": "Карточка происшествия как её видит диспетчер в АРМ-112 (поля по инструкции оператора 112 v2.1, см. docs/reference-ui)",
      "additionalProperties": false,
      "required": [
        "number",
        "registered_at_offset_s",
        "applicant",
        "address",
        "incident",
        "notification_list"
      ],
      "properties": {
        "number": {
          "type": "string",
          "pattern": "^[0-9]{6,12}$"
        },
        "registered_at_offset_s": {
          "type": "integer",
          "minimum": -3600,
          "maximum": 0,
          "description": "Время регистрации в 112 относительно момента направления карточки обучаемому (обычно −60…−10 с)"
        },
        "applicant": {
          "type": "object",
          "required": [
            "name",
            "phone"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "phone": {
              "type": "string",
              "pattern": "^\\+7[0-9]{10}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "witness",
                "victim",
                "relative",
                "acquaintance",
                "child",
                "participant"
              ],
              "description": "Статус заявителя как в 112: очевидец | пострадавший | родственник | знакомый | ребёнок | участник"
            }
          }
        },
        "address": {
          "type": "object",
          "required": [
            "district",
            "street",
            "house"
          ],
          "properties": {
            "district": {
              "type": "string"
            },
            "street": {
              "type": "string"
            },
            "house": {
              "type": "string"
            },
            "building": {
              "type": "string"
            },
            "entrance": {
              "type": "string"
            },
            "floor": {
              "type": "string"
            },
            "flat": {
              "type": "string"
            },
            "landmark": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "description": "Адрес одной строкой — так его сверяет оценка"
            },
            "country": {
              "type": "string",
              "description": "Страна"
            },
            "region": {
              "type": "string",
              "description": "Субъект"
            },
            "city": {
              "type": "string",
              "description": "Населённый пункт"
            },
            "okrug": {
              "type": "string",
              "description": "Округ"
            },
            "object": {
              "type": "string",
              "description": "Объект"
            },
            "structure": {
              "type": "string",
              "description": "Стр./соор."
            },
            "code": {
              "type": "string",
              "description": "Код домофона"
            },
            "descriptive": {
              "type": "string",
              "description": "Описательный адрес"
            }
          }
        },
        "incident": {
          "type": "object",
          "required": [
            "type_code",
            "type_name",
            "features",
            "description"
          ],
          "properties": {
            "type_code": {
              "type": "string",
              "description": "classifier_types.code"
            },
            "type_name": {
              "type": "string"
            },
            "features": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ]
              },
              "description": "Ответы опросной карты (кнопки-признаки): вопрос → выбранный вариант"
            },
            "description": {
              "type": "string",
              "minLength": 20,
              "maxLength": 1999,
              "description": "«Описание со слов заявителя», ≤ 1999 символов"
            },
            "victims": {
              "type": "integer",
              "minimum": 0
            },
            "danger": {
              "type": "string"
            }
          }
        },
        "notification_list": {
          "type": "array",
          "minItems": 1,
          "description": "Службы, которым направлена карточка; ровно одна — служба обучаемого (mine=true)",
          "items": {
            "type": "object",
            "required": [
              "service",
              "status"
            ],
            "properties": {
              "service": {
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/reaction"
              },
              "mine": {
                "type": "boolean"
              }
            }
          }
        },
        "phones": {
          "type": "object",
          "description": "Блок телефонов как в 112",
          "properties": {
            "aon": {
              "type": "string"
            },
            "provided": {
              "type": "string"
            },
            "on_site": {
              "type": "string"
            }
          }
        },
        "channel": {
          "type": "string",
          "description": "Канал связи (МТС, Билайн, стационарный…)"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "number",
        "voice",
        "phrases"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z_]{2,32}$"
        },
        "label": {
          "type": "string"
        },
        "number": {
          "type": "string",
          "pattern": "^[0-9]{3,4}$"
        },
        "voice": {
          "type": "string",
          "description": "Ключ голоса: male_calm | female_urgent | ... → TTS-модель и параметры"
        },
        "role": {
          "type": "string",
          "enum": ["crew", "control_112", "applicant", "other"],
          "default": "other",
          "description": "ADR-031: роль контакта ДДС — бригада, отдел контроля 112, заявитель, прочие; не секретна."
        },
        "phrases": {
          "type": "object",
          "required": [
            "greeting",
            "ack"
          ],
          "properties": {
            "greeting": {
              "type": "string",
              "default": "Слушаю вас"
            },
            "ack": {
              "type": "string",
              "default": "Информация принята"
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "at_s",
        "since",
        "delivery"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^e[0-9]{1,3}$"
        },
        "at_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800,
          "description": "Через сколько секунд после точки since"
        },
        "since": {
          "type": "string",
          "enum": [
            "offered",
            "opened",
            "accepted",
            "responding",
            "arrived",
            "working",
            "call_ended"
          ],
          "description": "Первое достижение anchor; событие планируется тогда, независимо от status_in. Повторный переход anchor не меняет. call_ended (ADR-031, ДДС) — завершение первого исходящего звонка контакту since_contact."
        },
        "since_contact": {
          "type": "string",
          "description": "contact.key; обязателен при since=call_ended и запрещён при других since (ADR-031)."
        },
        "status_in": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reaction"
          },
          "description": "Фильтр доставки при due_at, не момент планирования. После server_restart сроки не сдвигаются; overdue сообщение late, неподходящий статус на затронутой карточке ожидается до смены статуса или close/stop."
        },
        "delivery": {
          "type": "string",
          "enum": [
            "notice",
            "phone_incoming",
            "spawn_card"
          ]
        },
        "from": {
          "type": "string",
          "description": "contact.key для phone_incoming/notice"
        },
        "text": {
          "type": "string"
        },
        "voice": {
          "type": "boolean",
          "default": true,
          "description": "Озвучить при утверждении"
        },
        "spawn": {
          "type": "object",
          "additionalProperties": false,
          "description": "Для spawn_card: какую заранее подготовленную карточку создать. UUID версии намеренно не используется: seed должен переноситься между установками с разными внутренними UUID.",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "scenario"
            },
            "scenario_key": {
              "type": "string",
              "pattern": "^[a-z0-9-]{3,64}$",
              "description": "Стабильный scenarios.source_key для kind=scenario"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "description": "Номер версии scenario_key для kind=scenario"
            }
          },
          "allOf": [
            {
              "required": ["scenario_key", "version"]
            }
          ]
        },
        "expects": {
          "type": "object",
          "description": "Эталонная реакция на событие",
          "properties": {
            "status": {
              "$ref": "#/$defs/reaction"
            },
            "within_s": {
              "type": "integer",
              "minimum": 5
            },
            "action": {
              "type": "string",
              "enum": [
                "set_status",
                "add_comment",
                "call",
                "refuse_duplicate",
                "none"
              ]
            },
            "comment_facts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "ADR-031: факты, которые должны попасть в комментарий к статусу, поставленному в ответ на событие. Эталон, обучаемому не отдаётся; оценивает ИИ-судья ДДС-4."
            }
          }
        }
      },
      "if": {
        "required": ["since"],
        "properties": {"since": {"const": "call_ended"}}
      },
      "then": {"required": ["since_contact"]},
      "else": {"not": {"required": ["since_contact"]}}
    },
    "reference": {
      "type": "object",
      "description": "Эталон — то, с чем сравнивает оценка. Обучаемому не отдаётся.",
      "additionalProperties": false,
      "required": [
        "primary_decision",
        "expected_chain",
        "call"
      ],
      "properties": {
        "primary_decision": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "accepted",
                "not_accepted",
                "completed_without_team"
              ]
            },
            "reason_tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Для not_accepted: profile_mismatch | territory | duplicate | ..."
            },
            "comment_required": {
              "type": "boolean"
            },
            "comment_must_mention": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Сущности, которые должны быть в комментарии: адрес, причина, куда передано"
            }
          }
        },
        "expected_chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reaction"
          },
          "description": "Ожидаемая цепочка статусов после первичного решения"
        },
        "call": {
          "type": "object",
          "required": [
            "required"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "to": {
              "type": "string",
              "description": "contact.key"
            },
            "must_mention": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "address | incident_type | victims | measures"
            },
            "before_status": {
              "$ref": "#/$defs/reaction",
              "description": "Звонок должен быть до этого статуса"
            }
          }
        },
        "field_corrections": {
          "type": "array",
          "description": "Поля входящей карточки, которые обучаемый обязан исправить до указанного статуса (пилотное расширение слайса 2 — training/dds в срезе 3 определит команду исправления и её место в evidence). Исходное значение в card может намеренно не совпадать с expected_value — это и есть ошибка, которую находит обучаемый; отсутствие этого блока означает отсутствие ожидаемых исправлений.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "expected_value",
              "before_status"
            ],
            "properties": {
              "path": {
                "type": "string",
                "enum": [
                  "/card/address/okrug"
                ],
                "description": "JSON Pointer на поле card. Пилотный список путей — только адрес округа; расширяется по мере появления новых кейсов, не по одному сценарию за раз."
              },
              "expected_value": {
                "type": "string"
              },
              "before_status": {
                "$ref": "#/$defs/reaction",
                "description": "Исправление ожидается до простановки этого статуса"
              }
            }
          }
        },
        "pilot_goal": {
          "const": "accept_card",
          "description": "Пилотное упрощение цели прохождения (не команда закрытия и не самостоятельный close_reason): срез 2 показывает эталон преподавателю, срез 3 определит, как учебная цель соотносится с ADR-011/RFC §7.4 close. Отсутствие поля — обычные правила завершения ДДС."
        },
        "required_contacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "ДДС-3/ADR-032: contact.key, которым обязателен завершённый исходящий звонок независимо от reference.call (например, отдел контроля 112 при ошибке адреса). Проверяется критерием C_CALLS дополнительно к reference.call."
        },
        "guide_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ссылки на пункты памятки для обратной связи"
        },
        "notes": {
          "type": "string",
          "description": "Комментарий преподавателю"
        },
        "scoring": {"$ref": "#/$defs/scoring"}
      }
    }
  }
}
