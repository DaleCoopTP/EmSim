{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emsim.local/schemas/scenario/v1",
  "title": "ScenarioBody v1",
  "description": "Тело версии сценария (scenario_versions.body). Неизменяемо после утверждения. Генерируется LLM по этой же схеме и валидируется до записи.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_service",
    "card",
    "contacts",
    "events",
    "reference",
    "difficulty",
    "exercise_type"
  ],
  "properties": {
    "schema": {
      "const": "emsim/scenario/v1"
    },
    "target_service": {
      "type": "string",
      "description": "Код службы обучаемого (services.code)"
    },
    "card": {
      "$ref": "#/$defs/card"
    },
    "contacts": {
      "type": "array",
      "minItems": 0,
      "description": "Пусто, если ни один звонок сценарием не требуется (ни reference.call.required, ни события phone_incoming/notice не ссылаются на contact.key); тогда пустой список не удовлетворяет требованию звонка — семантическая проверка импортёра это гарантирует.",
      "items": {
        "$ref": "#/$defs/contact"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "reference": {
      "$ref": "#/$defs/reference"
    },
    "hints": {
      "type": "array",
      "description": "Подсказки для ознакомительного режима",
      "items": {
        "type": "object",
        "required": [
          "step",
          "text"
        ],
        "properties": {
          "step": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "guide_ref": {
            "type": "string"
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "description": "Происхождение, если сгенерировано",
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "ticket_id": {
          "type": "string",
          "format": "uuid"
        },
        "classifier_code": {
          "type": "string"
        }
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Сложность именно этой неизменяемой версии"
    },
    "exercise_type": {
      "type": "string",
      "const": "dds_processing",
      "description": "Тип упражнения. В первой поставке поддерживается ДДС; operator112_intake получит отдельный контракт позднее."
    }
  },
  "$defs": {
    "reaction": {
      "type": "string",
      "enum": [
        "added",
        "received",
        "accepted",
        "not_accepted",
        "responding",
        "arrived",
        "working",
        "completed",
        "refused",
        "completed_without_team"
      ]
    },
    "card": {
      "type": "object",
      "description": "Карточка происшествия как её видит диспетчер в АРМ-112 (поля по инструкции оператора 112 v2.1, см. docs/reference-ui)",
      "additionalProperties": false,
      "required": [
        "number",
        "registered_at_offset_s",
        "applicant",
        "address",
        "incident",
        "notification_list"
      ],
      "properties": {
        "number": {
          "type": "string",
          "pattern": "^[0-9]{6,12}$"
        },
        "registered_at_offset_s": {
          "type": "integer",
          "minimum": -3600,
          "maximum": 0,
          "description": "Время регистрации в 112 относительно момента направления карточки обучаемому (обычно −60…−10 с)"
        },
        "applicant": {
          "type": "object",
          "required": [
            "name",
            "phone"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "phone": {
              "type": "string",
              "pattern": "^\\+7[0-9]{10}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "witness",
                "victim",
                "relative",
                "acquaintance",
                "child",
                "participant"
              ],
              "description": "Статус заявителя как в 112: очевидец | пострадавший | родственник | знакомый | ребёнок | участник"
            }
          }
        },
        "address": {
          "type": "object",
          "required": [
            "district",
            "street",
            "house"
          ],
          "properties": {
            "district": {
              "type": "string"
            },
            "street": {
              "type": "string"
            },
            "house": {
              "type": "string"
            },
            "building": {
              "type": "string"
            },
            "entrance": {
              "type": "string"
            },
            "floor": {
              "type": "string"
            },
            "flat": {
              "type": "string"
            },
            "landmark": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "description": "Адрес одной строкой — так его сверяет оценка"
            },
            "country": {
              "type": "string",
              "description": "Страна"
            },
            "region": {
              "type": "string",
              "description": "Субъект"
            },
            "city": {
              "type": "string",
              "description": "Населённый пункт"
            },
            "okrug": {
              "type": "string",
              "description": "Округ"
            },
            "object": {
              "type": "string",
              "description": "Объект"
            },
            "structure": {
              "type": "string",
              "description": "Стр./соор."
            },
            "code": {
              "type": "string",
              "description": "Код домофона"
            },
            "descriptive": {
              "type": "string",
              "description": "Описательный адрес"
            }
          }
        },
        "incident": {
          "type": "object",
          "required": [
            "type_code",
            "type_name",
            "features",
            "description"
          ],
          "properties": {
            "type_code": {
              "type": "string",
              "description": "classifier_types.code"
            },
            "type_name": {
              "type": "string"
            },
            "features": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ]
              },
              "description": "Ответы опросной карты (кнопки-признаки): вопрос → выбранный вариант"
            },
            "description": {
              "type": "string",
              "minLength": 20,
              "maxLength": 1999,
              "description": "«Описание со слов заявителя», ≤ 1999 символов"
            },
            "victims": {
              "type": "integer",
              "minimum": 0
            },
            "danger": {
              "type": "string"
            }
          }
        },
        "notification_list": {
          "type": "array",
          "minItems": 1,
          "description": "Службы, которым направлена карточка; ровно одна — служба обучаемого (mine=true)",
          "items": {
            "type": "object",
            "required": [
              "service",
              "status"
            ],
            "properties": {
              "service": {
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/reaction"
              },
              "mine": {
                "type": "boolean"
              }
            }
          }
        },
        "phones": {
          "type": "object",
          "description": "Блок телефонов как в 112",
          "properties": {
            "aon": {
              "type": "string"
            },
            "provided": {
              "type": "string"
            },
            "on_site": {
              "type": "string"
            }
          }
        },
        "channel": {
          "type": "string",
          "description": "Канал связи (МТС, Билайн, стационарный…)"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "number",
        "voice",
        "phrases"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z_]{2,32}$"
        },
        "label": {
          "type": "string"
        },
        "number": {
          "type": "string",
          "pattern": "^[0-9]{3,4}$"
        },
        "voice": {
          "type": "string",
          "description": "Ключ голоса: male_calm | female_urgent | ... → TTS-модель и параметры"
        },
        "phrases": {
          "type": "object",
          "required": [
            "greeting",
            "ack"
          ],
          "properties": {
            "greeting": {
              "type": "string",
              "default": "Слушаю вас"
            },
            "ack": {
              "type": "string",
              "default": "Информация принята"
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "at_s",
        "since",
        "delivery"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^e[0-9]{1,3}$"
        },
        "at_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800,
          "description": "Через сколько секунд после точки since"
        },
        "since": {
          "type": "string",
          "enum": [
            "offered",
            "opened",
            "accepted",
            "responding",
            "arrived",
            "working"
          ],
          "description": "Первое достижение anchor; событие планируется тогда, независимо от status_in. Повторный переход anchor не меняет."
        },
        "status_in": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reaction"
          },
          "description": "Фильтр доставки при due_at, не момент планирования. После server_restart сроки не сдвигаются; overdue сообщение late, неподходящий статус на затронутой карточке ожидается до смены статуса или close/stop."
        },
        "delivery": {
          "type": "string",
          "enum": [
            "notice",
            "phone_incoming",
            "spawn_card"
          ]
        },
        "from": {
          "type": "string",
          "description": "contact.key для phone_incoming/notice"
        },
        "text": {
          "type": "string"
        },
        "voice": {
          "type": "boolean",
          "default": true,
          "description": "Озвучить при утверждении"
        },
        "spawn": {
          "type": "object",
          "additionalProperties": false,
          "description": "Для spawn_card: какую заранее подготовленную карточку создать. UUID версии намеренно не используется: seed должен переноситься между установками с разными внутренними UUID.",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "scenario"
            },
            "scenario_key": {
              "type": "string",
              "pattern": "^[a-z0-9-]{3,64}$",
              "description": "Стабильный scenarios.source_key для kind=scenario"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "description": "Номер версии scenario_key для kind=scenario"
            }
          },
          "allOf": [
            {
              "required": ["scenario_key", "version"]
            }
          ]
        },
        "expects": {
          "type": "object",
          "description": "Эталонная реакция на событие",
          "properties": {
            "status": {
              "$ref": "#/$defs/reaction"
            },
            "within_s": {
              "type": "integer",
              "minimum": 5
            },
            "action": {
              "type": "string",
              "enum": [
                "set_status",
                "add_comment",
                "call",
                "refuse_duplicate",
                "none"
              ]
            }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "description": "Эталон — то, с чем сравнивает оценка. Обучаемому не отдаётся.",
      "additionalProperties": false,
      "required": [
        "primary_decision",
        "expected_chain",
        "call"
      ],
      "properties": {
        "primary_decision": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "accepted",
                "not_accepted",
                "completed_without_team"
              ]
            },
            "reason_tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Для not_accepted: profile_mismatch | territory | duplicate | ..."
            },
            "comment_required": {
              "type": "boolean"
            },
            "comment_must_mention": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Сущности, которые должны быть в комментарии: адрес, причина, куда передано"
            }
          }
        },
        "expected_chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reaction"
          },
          "description": "Ожидаемая цепочка статусов после первичного решения"
        },
        "call": {
          "type": "object",
          "required": [
            "required"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "to": {
              "type": "string",
              "description": "contact.key"
            },
            "must_mention": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "address | incident_type | victims | measures"
            },
            "before_status": {
              "$ref": "#/$defs/reaction",
              "description": "Звонок должен быть до этого статуса"
            }
          }
        },
        "field_corrections": {
          "type": "array",
          "description": "Поля входящей карточки, которые обучаемый обязан исправить до указанного статуса (пилотное расширение слайса 2 — training/dds в срезе 3 определит команду исправления и её место в evidence). Исходное значение в card может намеренно не совпадать с expected_value — это и есть ошибка, которую находит обучаемый; отсутствие этого блока означает отсутствие ожидаемых исправлений.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "expected_value",
              "before_status"
            ],
            "properties": {
              "path": {
                "type": "string",
                "enum": [
                  "/card/address/okrug"
                ],
                "description": "JSON Pointer на поле card. Пилотный список путей — только адрес округа; расширяется по мере появления новых кейсов, не по одному сценарию за раз."
              },
              "expected_value": {
                "type": "string"
              },
              "before_status": {
                "$ref": "#/$defs/reaction",
                "description": "Исправление ожидается до простановки этого статуса"
              }
            }
          }
        },
        "pilot_goal": {
          "const": "accept_card",
          "description": "Пилотное упрощение цели прохождения (не команда закрытия и не самостоятельный close_reason): срез 2 показывает эталон преподавателю, срез 3 определит, как учебная цель соотносится с ADR-011/RFC §7.4 close. Отсутствие поля — обычные правила завершения ДДС."
        },
        "guide_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ссылки на пункты памятки для обратной связи"
        },
        "notes": {
          "type": "string",
          "description": "Комментарий преподавателю"
        },
        "scoring": {
          "type": "object",
          "description": "Поправки к рубрике по умолчанию (ADR-013). Только отличия; отсутствие блока = дефолт.",
          "additionalProperties": false,
          "properties": {
            "weights": {
              "type": "object",
              "description": "criterion id → вес (переопределяет дефолт; нормируется к 100 среди включённых)",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "critical": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Критерии, невыполнение которых в этом кейсе критично (например G_ADDRESS при пострадавших)"
            },
            "disabled": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Критерии, не применимые к кейсу (например D_COMMENT_CONTENT, если комментарий не нужен)"
            },
            "note": {
              "type": "string",
              "description": "Почему поправки такие — для преподавателя"
            }
          }
        }
      }
    }
  }
}
