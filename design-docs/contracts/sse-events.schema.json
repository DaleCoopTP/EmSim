{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emsim.local/schemas/sse-events/v1",
  "title": "SSE invalidation frames v1",
  "description": "Логическое представление SSE-фрейма: transport передаёт event, id и JSON data. id=<stream_epoch>:<counter>; epoch меняется при рестарте или потере LISTEN. Сначала stream.ready и буферизация, затем snapshot и применение invalidation; resync повторяет этот цикл.",
  "oneOf": [
    { "$ref": "#/$defs/stream_ready" },
    { "$ref": "#/$defs/resync" },
    { "$ref": "#/$defs/invalidate" }
  ],
  "$defs": {
    "cursor": {
      "type": "string",
      "pattern": "^[1-9][0-9]*:[0-9]+$",
      "description": "Курсор потока: <epoch>:<counter>."
    },
    "stream_ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "id", "data"],
      "properties": {
        "event": { "const": "stream.ready" },
        "id": { "$ref": "#/$defs/cursor" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cursor"],
          "properties": { "cursor": { "$ref": "#/$defs/cursor" } }
        }
      }
    },
    "resync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "id", "data"],
      "properties": {
        "event": { "const": "resync" },
        "id": { "$ref": "#/$defs/cursor" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cursor"],
          "properties": { "cursor": { "$ref": "#/$defs/cursor" } }
        }
      }
    },
    "invalidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "id", "data"],
      "properties": {
        "event": { "const": "invalidate" },
        "id": { "$ref": "#/$defs/cursor" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "lesson_id": { "type": "string", "format": "uuid" },
            "user_id": { "type": "string", "format": "uuid" },
            "item_id": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  }
}
