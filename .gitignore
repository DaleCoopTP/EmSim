# Local editor and OS files
.DS_Store
.idea/
.vscode/

# Local configuration and secrets
.env
.env.*
!.env.example
!.env.*.example

# Temporary files and source archives
/tmp/
/*.zip
*.log

# Reference copy of orchestration-core (ported by copy, see docs/technical-discovery.md)
/orchestration-core-main/

# Model weights for compose.yaml's llm service (ADR-029, `make model`)
/models/

# Source materials (PDF/XLSX) live outside the repository until needed for import
/*.pdf
/*.xlsx

# Build and test output
/bin/
/build/
/dist/
/coverage/
/coverage.out
*.test
web/test-results/
web/playwright-report/

# Local dependency caches
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# Classroom CA root certificate exported by `make class-ca` (ADR-033)
/emsim-root.crt

# Backup copies written by the worker (ADR-033, BACKUP_HOST_DIR)
/backups/
