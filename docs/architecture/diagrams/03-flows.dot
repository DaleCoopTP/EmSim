digraph G {
graph [rankdir=TB, newrank=true, bgcolor="white", pad=0.28, nodesep=0.4, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=17, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#f3f6fa", color="#aebdce", penwidth=1.2, fontname="Arial", fontsize=15, margin="0.2,0.14", fontcolor="#17304d"];
edge [color="#6b829b", arrowsize=0.8, penwidth=1.4, fontname="Arial", fontsize=12, fontcolor="#405974"];
start [label="Преподаватель: publish → assign → start\nFreeze scenario / rubric / classifier / source pool"];
subgraph cluster_a {label="ЗАДАЧА 1 · call_card";color="#b0c7df";style=rounded;
a1 [label="Входящий текст / голос\nодин ответ CallerSimulator"];
a2 [label="Действие оператора\nсообщение + ручная карточка",fillcolor="#173e69",fontcolor="white",color="#173e69"];
a3 [label="Durable command transaction\nreceipt + evidence + next turn task",fillcolor="#e8f4ef",color="#79aa93",fontcolor="#204e3a"];
a4 [label="SubmitItem / stop\nготовая или прерванная карточка"];
a1 -> a2 [label="",style=solid];
a2 -> a3 [label="",style=solid];
a3 -> a1 [label="следующая реплика",style=solid];
a3 -> a4 [label="сохранить",style=solid];
}
subgraph cluster_b {label="ЗАДАЧА 2 · card_workflow";color="#b0c7df";style=rounded;
b1 [label="Выбор из frozen pool\nsystem / student / mixed"];
b2 [label="Действия своей службы\nстатус · комментарий · запрос службы",fillcolor="#173e69",fontcolor="white",color="#173e69"];
b3 [label="Workflow + durable command\nтаймер от направления карточки",fillcolor="#e8f4ef",color="#79aa93",fontcolor="#204e3a"];
b4 [label="SubmitItem / stop\nследующая карточка, если lesson active"];
b1 -> b2 [label="",style=solid];
b2 -> b3 [label="",style=solid];
b3 -> b4 [label="",style=solid];
b4 -> b1 [label="next-card",style=solid];
}
evidence [label="Immutable evidence\nсообщения · карточка · действия · нормы\ncutoff + coverage + hashes",fillcolor="#e8f4ef",color="#79aa93",fontcolor="#204e3a"];
score [label="Assessment → reporting\nправила + семантика + грамматика\nоценка / review / unavailable",fillcolor="#173e69",fontcolor="white",color="#173e69"];
start -> a1 [lhead=cluster_a];
start -> b1 [lhead=cluster_b];
a4 -> evidence [label="",style=solid];
b4 -> evidence [label="",style=solid];
evidence -> score [label="",style=solid];
{rank=same;a1;b1;}
{rank=same;a2;b2;}
{rank=same;a3;b3;}
{rank=same;a4;b4;}
}
