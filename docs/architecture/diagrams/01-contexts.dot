digraph G {
graph [rankdir=TB, newrank=true, bgcolor="white", pad=0.28, nodesep=0.4, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=17, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#f3f6fa", color="#aebdce", penwidth=1.2, fontname="Arial", fontsize=15, margin="0.2,0.14", fontcolor="#17304d"];
edge [color="#6b829b", arrowsize=0.8, penwidth=1.4, fontname="Arial", fontsize=12, fontcolor="#405974"];
actors [label="Оператор · Преподаватель · Администратор\nWeb UI на русском · роли и принадлежность ресурса"];
iam [label="Identity & Access\nлокальные users / IdP\nsessions · permissions"];
curr [label="Curriculum\nScenarioVersion · Rubric\nматериалы · публикация"];
catalog [label="Catalog\nЕКП · службы · CardTemplate\nsystem / student / mixed"];
teach [label="Teaching\nLesson → Assignment\nплан · назначения · stop"];
train [label="Training — CORE DOMAIN\nTrainingRun → RunItem\nдиалог + карточка + реакции служб",fillcolor="#173e69",fontcolor="white",color="#173e69"];
assess [label="Assessment — CORE DOMAIN\nправила + semantic judge\nкритерии + экспертные ревизии",fillcolor="#173e69",fontcolor="white",color="#173e69"];
report [label="Reporting\nистория · прогресс · отчёты\nбез LLM на пути чтения",fillcolor="#e8f4ef",color="#79aa93",fontcolor="#204e3a"];
kernel [label="Execution kernel\nперенос и адаптация core\nleases · fencing · retries",fillcolor="#eee9fb",color="#8a74b3",fontcolor="#443567"];
ops [label="Operations\naudit · backup · diagnostics\nуправление конфигурацией"];
{rank=same;curr;catalog;teach;}
{rank=same;iam;train;kernel;}
{rank=same;assess;ops;}
actors -> teach [label="управление",style=solid];
actors -> iam [label="аутентификация",style=solid];
curr -> train [label="PublishedScenario",style=solid];
catalog -> teach [label="frozen pool",style=solid];
teach -> train [label="LessonPlanSnapshot",style=solid];
train -> assess [label="RunEvidenceV1",style=solid];
assess -> report [label="AssessmentResultV1",style=solid];
iam -> train [label="",style=dashed];
kernel -> train [label="turn / seal jobs",style=dashed];
kernel -> assess [label="evaluate jobs",style=dashed];
teach -> ops [label="audit",style=dashed];
assess -> ops [label="audit revision",style=dashed];
}
