digraph G {
graph [rankdir=TB, newrank=true, bgcolor="white", pad=0.28, nodesep=0.4, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=17, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#f3f6fa", color="#aebdce", penwidth=1.2, fontname="Arial", fontsize=15, margin="0.2,0.14", fontcolor="#17304d"];
edge [color="#6b829b", arrowsize=0.8, penwidth=1.4, fontname="Arial", fontsize=12, fontcolor="#405974"];
request [label="Преподаватель → StopLesson\ncommand_id + причина"];
barrier [label="1. Атомарный барьер\nlesson FOR UPDATE → stopping → epoch++\naudit + durable close job → COMMIT",fillcolor="#fff0d7",color="#c7a061",fontcolor="#66471a"];
late [label="Поздний ответ LLM / команда / next-card\nпроверка lesson state + epoch\nэффект запрещён после барьера",fillcolor="#fff0d7",color="#c7a061",fontcolor="#66471a"];
seal [label="2. Завершение runs малыми batches\ncutoff sequence · interrupted item\nсохранить evidence · cancel interaction tasks",fillcolor="#e8f4ef",color="#79aa93",fontcolor="#204e3a"];
terminal [label="3. TrainingRun = stopped\nLesson = finished, когда runs sealed\nповторный worker безопасен",fillcolor="#173e69",fontcolor="white",color="#173e69"];
media [label="Media stop\nbridge / playback epoch\nне воспроизводить позднее аудио"];
judge [label="4. Assessment продолжается отдельно\nready / needs_review / unavailable\nне удерживает занятие открытым",fillcolor="#173e69",fontcolor="white",color="#173e69"];
offline [label="Ввод, восстановленный после stop\nсохранить как supplemental\nне менять frozen evidence",fillcolor="#e8f4ef",color="#79aa93",fontcolor="#204e3a"];
request -> barrier [label="",style=solid];
barrier -> late [label="fencing",style=solid];
barrier -> seal [label="background",style=solid];
barrier -> media [label="revoke interaction",style=solid];
seal -> terminal [label="",style=solid];
terminal -> judge [label="",style=solid];
offline -> judge [label="только явная expert revision",style=dashed];
{rank=same;late;seal;media;}
{rank=same;terminal;offline;}
}
