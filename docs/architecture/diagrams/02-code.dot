digraph G {
graph [rankdir=TB, newrank=true, bgcolor="white", pad=0.28, nodesep=0.4, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=17, compound=true];
node [shape=box, style="rounded,filled", fillcolor="#f3f6fa", color="#aebdce", penwidth=1.2, fontname="Arial", fontsize=15, margin="0.2,0.14", fontcolor="#17304d"];
edge [color="#6b829b", arrowsize=0.8, penwidth=1.4, fontname="Arial", fontsize=12, fontcolor="#405974"];
ui [label="web/src\noperator · instructor · admin\ncommand-buffer · event-stream · media"];
api [label="cmd/api → HTTP / SSE adapters\nauth → DTO validation → application service"];
subgraph cluster_training { label="internal/training"; labeljust=l; color="#bccbdd"; style=rounded;
apps [label="application\nStartRun · ApplyCommand · OfferNextCard\nGenerateTurn · SealRun"];
domain [label="domain\nRun · Card · Conversation · ServiceReaction\nTimingPolicy · DisclosurePolicy",fillcolor="#173e69",fontcolor="white",color="#173e69"];
ports [label="ports\nTrainingTransaction · TurnCommitter\nCallerSimulator · EvidenceReader"];
apps -> domain [label="правила",style=solid];
apps -> ports [label="зависимости",style=solid];
}
assess [label="internal/assessment\nDeterministicEvaluator · SemanticJudge\nScoreAggregator · AssessmentCommitter",fillcolor="#173e69",fontcolor="white",color="#173e69"];
pg [label="adapters/postgres\natomic effect + task + audit + outbox\nlocks · unique keys · snapshots",fillcolor="#e8f4ef",color="#79aa93",fontcolor="#204e3a"];
llm [label="adapters/inference\nлокальный HTTP endpoint\nschema validation · deadlines"];
workers [label="cmd/worker\ninteractive · assessment · content\nreport · maintenance"];
exec [label="platform/execution\nqueue · worker · recovery\nадаптированный orchestration core",fillcolor="#eee9fb",color="#8a74b3",fontcolor="#443567"];
{rank=same;domain;ports;}
{rank=same;pg;llm;}
{rank=same;workers;exec;}
ui -> api [label="commands / events",style=solid];
api -> apps [label="use cases",style=solid];
ports -> pg [label="реализует порт",dir=back,arrowtail=empty,style=dashed];
ports -> llm [label="реализует порт",dir=back,arrowtail=empty,style=dashed];
apps -> assess [label="только immutable evidence",style=solid];
workers -> exec [label="Runner + Handler",style=solid];
exec -> apps [label="dispatch",style=dashed];
assess -> pg [label="result commit",style=solid];
}
